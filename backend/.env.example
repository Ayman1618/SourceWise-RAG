# Application Configuration
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# PORT=8000  # (Optional: overrides BACKEND_PORT for container platforms like Render/Railway/Fly.io)

# CORS / Allowed Frontend Origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini Free-Tier Provider Configuration
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=<your-free-tier-gemini-key>
GEMINI_GENERATION_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=1536

# Provider Configuration (Defaults to Gemini)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
MIN_EVIDENCE_SCORE=0.0

# Qdrant Vector Store Configuration (Local Docker or Qdrant Cloud Free Tier)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=sourcewise_documents
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=10.0




