# Application Configuration
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Embedding Provider Configuration (OpenAI-compatible)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=your_openai_or_compatible_api_key_here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_BATCH_SIZE=64

# Qdrant Vector Store Configuration
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION_NAME=sourcewise_documents
# QDRANT_VECTOR_SIZE=1536
# QDRANT_DISTANCE=Cosine
# QDRANT_TIMEOUT=10.0

# LLM / Grounded Generation Configuration (OpenAI-compatible)
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_or_compatible_api_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=1024
# MIN_EVIDENCE_SCORE=0.0


