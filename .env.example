# Application
APP_ENV=development

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# Google Gemini Free-Tier Provider
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=<your-free-tier-key>
GEMINI_GENERATION_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=1536

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=sourcewise_documents
QDRANT_VECTOR_SIZE=1536

