# Application
APP_ENV=development

# Backend Network & Port Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# PORT=8000  # (Cloud platform port override e.g. Render, Railway, Fly.io)

# CORS / Allowed Frontend Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Gemini Free-Tier Configuration
# Obtain free API key at: https://aistudio.google.com/
GEMINI_API_KEY=<your-free-tier-gemini-key>
GEMINI_GENERATION_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=1536

# Qdrant Vector Database (Local or Qdrant Cloud Free Tier)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=sourcewise_documents
QDRANT_VECTOR_SIZE=1536


